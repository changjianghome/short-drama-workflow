# ============================================================
# short-drama-workflow 统一环境配置示例
# 使用方式：复制本文件为仓库根目录下的 .env，填写真实值后：
#   set -a; source ./.env; set +a
# ⚠️ .env 含真实密钥，已被 .gitignore 排除，严禁提交/分享！
# ============================================================

# ---------- 1. RunningHub（必填，runninghub-api）----------
# 单个账号 API Key（32位 hex）
RUNNINGHUB_API_KEY=<你的32位hex>

# RH 余额追踪 .env 路径（rh_tracker.py 默认读"当前目录 .env"；
# 运行时若工作目录不是仓库根，用绝对路径指向本文件）：
RH_ENV_PATH=.env

# 多账号表（可选）：供 query_account_api.py --all 查询全部账号余额
# 两种方式任选：
#   a) 环境变量（JSON 字符串，注意转义）：
RH_ACCOUNTS_JSON={"账号1":"<32位hex>","账号2":"<32位hex>","账号3":"<32位hex>"}
#   b) 独立文件（推荐，避免转义）：
#      在 runninghub-api/scripts/.accounts.json 中写：
#      {"账号1":"<32位hex>","账号2":"<32位hex>"}

# ---------- 2. GRS 绘图（必填，grs-image-api）----------
GRSAI_API_KEY=<你的GRS key>

# ---------- 3. 飞书机器人（可选，feishu-bot，仅成品发送用）----------
# FEISHU_APP_ID=cli_xxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxx
# FEISHU_CHAT_ID=oc_xxxxxxxx        # 目标群/用户 ID

# ---------- 4. Mac 语音播报（可选，mac-say）----------
# 直接指定完整地址（推荐，与 SKILL.md 占位符等价）：
# MAC_SAY_URL=http://<MAC_SAY_PRIMARY_IP>:12345/say
# 备用地址占位：
# MAC_SAY_BACKUP_URL=http://<MAC_SAY_BACKUP_IP>:12345/say_server
