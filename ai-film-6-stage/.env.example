# ===== 配置模板（复制为 .env 后填写，切勿分享真实值）=====
# 完整版统一配置见上级目录 ../.env.example（short-drama-workflow 根目录），
# 运行时加载 ../.env：set -a; source ../.env; set +a

# RunningHub API Key（单个账号）
RUNNINGHUB_API_KEY=<你的32位hex>

# RunningHub 多账号表（可选，供 query_account_api.py --all 使用；也可放 ../runninghub-api/scripts/.accounts.json）
# RH_ACCOUNTS_JSON={"账号1":"<32位hex>","账号2":"<32位hex>"}

# RH 余额追踪 .env 路径（默认当前目录 .env）
# RH_ENV_PATH=.env

# GRS 绘图 API Key
GRSAI_API_KEY=<你的GRS key>

# 飞书机器人（可选，仅阶段6成品发送用）
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# FEISHU_CHAT_ID=oc_xxx

# Mac 语音播报服务（可选，改为你本机 Mac 语音服务内网 IP）
# MAC_SAY_URL=http://<MAC_SAY_PRIMARY_IP>:12345/say
